        "jsCode": "const sourceGroup = $('Switch').first().json.payload.from;\nconst session = $('Switch').first().json.session;\n\n// backend description\nconst text =\n  $input.first().json.alertEvent?.ml?.description ||\n  $input.first().json.message ||\n  'Peringatan terdeteksi.';\n\n// location text coming from previous node\n  const locationText = `https://maps.google.com/?q=${$('Code in JavaScript4').first().json.latitude},${$('Code in JavaScript4').first().json.longitude}` || \"Lokasi tidak diketahui\";\n\n\nconst GROUPS = {\n  lampuk: '120363406629965480@g.us',\n  lhoknga: '120363425830719164@g.us',\n};\n\nlet targets = [];\n\nif (sourceGroup === GROUPS.lampuk) {\n  targets = [GROUPS.lampuk, GROUPS.lhoknga];\n} else if (sourceGroup === GROUPS.lhoknga) {\n  targets = [GROUPS.lhoknga, GROUPS.lampuk];\n} else {\n  targets = [sourceGroup];\n}\n\nreturn targets.map(chatId => ({\n  json: {\n    session,\n    chatId,\n    text,\n    locationText,\n    sourceGroup,\n  }\n}));"
      },

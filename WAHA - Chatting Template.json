    {
      "parameters": {
        "jsCode": " const parts = $('Message a model').first().json.content.parts;\n\n  // Find the part that is NOT a thought (the actual response)\n  const responsePart = parts.find(p => !p.thought);\n  const rawText = responsePart.text.replace(/```json|```/g, \"\").trim();\n\n  let result;\n  try {\n    result = JSON.parse(rawText);\n  } catch (e) {\n    result = {\n      lik_codes: [\"unknown\"],\n      location_context: \"unknown\"\n    };\n  }\n\n  const chatId = $('check-message-and-user').first().json.payload.from;\n\n  const beachMap = ({\n    \"120363406629965480@g.us\": \"pantai_lampuuk\",\n    \"120363425830719164@g.us\": \"pantai_lhoknga\"\n  });\n\n  return {\n    lik_codes: result.lik_codes || [\"unknown\"],\n    location_context: result.location_context || \"unknown\",\n    beach_location: beachMap[chatId] || \"unknown_beach\"\n  };"
      },

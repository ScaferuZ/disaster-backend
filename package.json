{
  "name": "disaster-backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "test": "bun test",
    "push:vapid:generate": "bunx web-push generate-vapid-keys",
    "stage6:reset": "bun run scripts/stage6/reset-run.ts",
    "stage6:run": "bun run scripts/stage6/run-iteration.ts",
    "stage6:load": "bun run scripts/stage6/run-report-load.ts",
    "stage6:export": "bun run scripts/stage6/export-streams.ts",
    "stage6:analyze": "bun run scripts/stage6/analyze.ts",
    "stage6:sample:resources": "bun run scripts/stage6/sample-resources.ts",
    "analyze:comparison": "bun run scripts/analyze-comparison.ts",
    "compare:run": "bun run scripts/run-comparison.ts",
    "analyze:whatsapp": "bun run scripts/analyze-whatsapp-webhooks.ts",
    "n8n:workflow:check": "bun run scripts/deploy-n8n-workflow.ts --check-remote",
    "n8n:workflow:dry-run": "bun run scripts/deploy-n8n-workflow.ts",
    "n8n:workflow:push": "bun run scripts/deploy-n8n-workflow.ts --push",
    "n8n:workflow:push:activate": "bun run scripts/deploy-n8n-workflow.ts --push --activate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "hono": "^4.11.7",
    "redis": "^5.10.0",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7"
  }
}
